{
  "Jwt": {
    "Issuer": "ChatApi",
    "Audience": "ChatClient",
    "ExpiryMinutes": 30,
    "RefreshTokenDays": 30,
    "RefreshGraceSeconds": 30
  },
  "Swagger": {
    "Enabled": false,
    "Title": "Chat API",
    "Version": "v1",
    "Description": "Real-time Chat API with JWT authentication",
    "Contact": {
      "Name": "API Support Team",
      "Email": "support@myapi.com",
      "Url": "https://myapi.com"
    }
  },
  "RateLimiting": {
    "PerUserPerMinute": 300,
    "PerIpPerMinute": 100,
    "CommandsPer10Seconds": 20
  },
  "Messages": {
    "EditWindowHours": 48,
    "DeleteWindowHours": 48
  },
  "Groups": {
    "MaxMembers": 500
  },
  "Storage": {
    "Endpoint": "",
    "PublicUrl": "",
    "Bucket": "media",
    "Region": "us-east-1"
  },
  "Media": {
    "MaxFileSizeMb": 100,
    "MaxPhotoSizeMb": 20,
    "PreviewSize": 640,
    "UploadUrlMinutes": 30,
    "DownloadUrlMinutes": 60,
    "PendingUploadHours": 24,
    "MaxPendingUploads": 50,
    "UnusedFileHours": 24,
    "RetentionDays": 0
  },
  "Push": {
    "VapidPublicKey": "",
    "VapidPrivateKey": "",
    "Subject": "",
    "TtlSeconds": 86400
  },
  "Outbox": {
    "PollIntervalMs": 1000
  },
  "Sync": {
    "RetentionDays": 30,
    "CleanupIntervalMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*"
}