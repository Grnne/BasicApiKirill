# Reverse proxy in front of the API: TLS (the Let's Encrypt certificate is issued
# and renewed automatically), HTTP → HTTPS, WebSocket for SignalR.
# DOMAIN and ACME_EMAIL come from .env.prod via docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Caddy sets X-Forwarded-For/-Proto itself and does not trust the same headers
	# from the client, so the client IP cannot be spoofed through the proxy.
	reverse_proxy basicapi:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format json
	}
}
