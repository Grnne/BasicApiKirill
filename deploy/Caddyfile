# Reverse proxy in front of the API: TLS (the Let's Encrypt certificate is issued
# and renewed automatically), HTTP → HTTPS, WebSocket for SignalR.
# DOMAIN and ACME_EMAIL come from .env.prod via docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
	# Error lines (an upstream down) carry the request too: filtered as the access log below.
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete access_token
					delete X-Amz-Signature
					delete X-Amz-Credential
				}
			}
		}
	}
}

{$DOMAIN} {
	# Files (plan 2, F4): signed links go straight to the storage. The signature covers the
	# host, and Caddy passes the Host header through unchanged, so links signed for {$DOMAIN}
	# check out. Whatever a user uploaded is never active content on the site (R32): the
	# browser must not guess the type, and a page from here gets no script and no origin.
	handle /media/* {
		# A video frame the client uploads for the preview (key c/…) is at most 2 MB, the API's
		# MaxThumbnailSize. Its size is not announced, so its link cannot be signed for it as the
		# file's link is — the cap is here instead.
		@clientFrame path_regexp ^/media/[^/]+/c/
		request_body @clientFrame {
			max_size 2MB
		}
		reverse_proxy seaweedfs:8333
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
			X-Frame-Options DENY
			-Server
		}
	}

	# Caddy sets X-Forwarded-For/-Proto itself and does not trust the same headers
	# from the client, so the client IP cannot be spoofed through the proxy.
	# The API takes only JSON, a few KB at most; files go to /media. A bigger body is refused here
	# with 413 and never reaches the API.
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy basicapi:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Credentials ride in query strings: SignalR's access token (WebSocket cannot carry a header) and
	# the signatures of file links. Whoever reads the logs must not get working ones.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete access_token
					delete X-Amz-Signature
					delete X-Amz-Credential
				}
			}
		}
	}
}
