# ═══════════════════════════════════════════════════════════════════════
#  BasicChatApi — PRODUCTION secrets (DO NOT COMMIT!)
#
#  Usage:
#    cp .env.prod.example .env.prod
#    # generate strong values:
#    #   openssl rand -base64 24      (Linux/Mac/Git Bash)
#    #   [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256}))   (PowerShell)
#
#  Start: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# ═══════════════════════════════════════════════════════════════════════

# ─── Database ───────────────────────────────────────────────────────────
# DO NOT keep the default postgres/postgres: it is the first thing bots brute-force.
DB_USER=chat_app
DB_PASSWORD=CHANGE_ME__openssl_rand_-base64_24
DB_NAME=chatdb

# ─── Domain and TLS (Caddy) ─────────────────────────────────────────────
# The domain the Let's Encrypt certificate is issued for. Its DNS A/AAAA record
# must point to the server, and ports 80 and 443 must be open.
DOMAIN=chat.example.com
# Email for Let's Encrypt notices (certificate expiry and the like)
ACME_EMAIL=admin@example.com
# Subnet of the docker network between Caddy and the API. Change it only if it
# overlaps with the server's networks.
PROXY_SUBNET=172.30.0.0/24
# The address users open, if it is not https://DOMAIN (e.g. a non-standard port).
# File links are signed for it. Usually leave empty.
PUBLIC_URL=

# ─── File storage (SeaweedFS, S3 API) ───────────────────────────────────
# Keys the API signs upload and download links with. Only the API and the storage
# know them; clients get short-lived signed links. Generate: openssl rand -base64 24
STORAGE_ACCESS_KEY=chat-media
STORAGE_SECRET_KEY=CHANGE_ME__openssl_rand_-base64_24

# ─── Push notifications (WebPush) ───────────────────────────────────────
# The VAPID key pair the server signs pushes with. Empty — push is off. Generate:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm --no-deps basicapi --generate-vapid-keys
# Keep them: browsers' subscriptions are tied to the public key, a new pair ends them all.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# How push services reach the operator: mailto:admin@example.com or https://… (empty — https://DOMAIN).
PUSH_SUBJECT=

# ─── JWT (token signing) ───────────────────────────────────────────────
# 🛡 At least 32 bytes! With a weak or default key anyone can forge a token and
#    sign in as any user. The application does not start with a key shorter than
#    32 bytes or with the CHANGE_ME placeholder.
#    Generate: openssl rand -base64 48
JWT_KEY=CHANGE_ME__openssl_rand_-base64_48
JWT_ISSUER=ChatApi
JWT_AUDIENCE=ChatClient
# Access token lifetime, minutes (1440 = 24h; 60–120 is better for production)
JWT_EXPIRY_MINUTES=60

# ─── Swagger ────────────────────────────────────────────────────────────
# /swagger — API description. Off by default in production: no need to expose
# the API surface. true — turn it on.
SWAGGER_ENABLED=false

# ─── Hosts ──────────────────────────────────────────────────────────────
# Allowed Host headers, comma-separated, e.g.: chat.example.com,localhost
# Keep * only if there is no domain.
ALLOWED_HOSTS=*

# ─── CORS ───────────────────────────────────────────────────────────────
# Origins allowed to call the API with credentials (cookies/JWT), comma-separated,
# e.g.: https://chat.example.com. Empty = same origin only (safe: the frontend
# is served by the API itself from wwwroot/client).
ALLOWED_ORIGINS=

# ─── Memory ─────────────────────────────────────────────────────────────
# Container limits; the defaults add up to 1 GB — enough for ~100 clients online
# (docs/capacity-and-limits.md). For ~2000: Postgres 768M, API 512M, Caddy 512M, pool 30.
# POSTGRES_MEMORY=320M
# API_MEMORY=256M
# STORAGE_MEMORY=256M
# CADDY_MEMORY=192M
# DB_POOL_SIZE=10
