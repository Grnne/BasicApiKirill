# ═══════════════════════════════════════════════════════════════════════
#  BasicChatApi — ПРОДАКШЕН-секреты (НЕ КОММИТИТЬ!)
#
#  Использование:
#    cp .env.prod.example .env.prod
#    # сгенерировать сильные значения:
#    #   openssl rand -base64 24      (Linux/Mac/Git Bash)
#    #   [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256}))   (PowerShell)
#
#  Запуск: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# ═══════════════════════════════════════════════════════════════════════

# ─── База данных ────────────────────────────────────────────────────────
# НЕ оставляй дефолтные postgres/postgres — это первое, что брутфорсят боты.
DB_USER=chat_app
DB_PASSWORD=CHANGE_ME__openssl_rand_-base64_24
DB_NAME=chatdb

# ─── API ────────────────────────────────────────────────────────────────
# Внешний порт на хосте (внутри контейнера всегда 8080)
HOST_PORT=8080

# ─── JWT (подпись токенов) ─────────────────────────────────────────────
# 🛡 Минимум 32 байта! Если ключ слабый/дефолтный — любой сможет подделать
#    токен и залогиниться под любым пользователем.
#    Сгенерируй: openssl rand -base64 48
JWT_KEY=CHANGE_ME__openssl_rand_-base64_48
JWT_ISSUER=ChatApi
JWT_AUDIENCE=ChatClient
# Время жизни токена, минуты (1440 = 24ч; для боевого лучше 60–120)
JWT_EXPIRY_MINUTES=60

# ─── Hosts ──────────────────────────────────────────────────────────────
# Разрешённые Host-заголовки через запятую, напр.: chat.example.com,localhost
# Оставь * только если нет домена.
ALLOWED_HOSTS=*

# ─── CORS ───────────────────────────────────────────────────────────────
# Origin'ы, которым разрешён доступ к API с credentials (куки/JWT), через
# запятую, напр.: https://chat.example.com. Пусто = только тот же origin
# (безопасно, т.к. фронтенд отдаётся тем же API из wwwroot/app).
ALLOWED_ORIGINS=
