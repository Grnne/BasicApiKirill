# Куда Vite проксирует /api и /hubs в режиме разработки.
# Профиль "http" из BasicApi/Properties/launchSettings.json:
VITE_API_TARGET=http://localhost:5235
# Если API поднят через docker-compose:
# VITE_API_TARGET=http://localhost:8080

# Куда Vite проксирует /media — файлы по подписанным ссылкам (SeaweedFS из docker-compose).
# API должен подписывать ссылки на адрес Vite: Storage__PublicUrl=http://localhost:5173
# (так задано в профилях launchSettings.json).
VITE_MEDIA_TARGET=http://localhost:8333
